<%- include('partials/header') %>

<article class="single-post" id="single-post">
  <div class="post-header">
    <a href="/" class="back-link" id="back-link">← Back to all posts</a>
    <div class="post-meta-single">
      <span class="post-author-single"><%= post.author %></span>
      <span class="meta-dot">·</span>
      <time class="post-date-single"><%= formatDate(post.createdAt) %></time>
    </div>
    <h1 class="post-title-single"><%= post.title %></h1>
  </div>

  <div class="post-body" id="post-body">
    <% post.content.split('\n').forEach(paragraph => { %>
      <% if (paragraph.trim()) { %>
        <p><%= paragraph %></p>
      <% } %>
    <% }) %>
  </div>

  <div class="post-footer-single" id="post-footer-single">
    <div class="post-actions-single">
      <a href="/posts/<%= post.id %>/edit" class="btn btn-outline" id="edit-post-btn">✏️ Edit Post</a>
      <form action="/posts/<%= post.id %>?_method=DELETE" method="POST" class="delete-form">
        <button type="submit" class="btn btn-danger" id="delete-post-btn">🗑️ Delete Post</button>
      </form>
    </div>
  </div>
</article>

<%- include('partials/footer') %>
