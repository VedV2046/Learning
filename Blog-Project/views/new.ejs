<%- include('partials/header') %>

<section class="form-page" id="new-post-page">
  <div class="form-container">
    <h1 class="form-title">Create a New Post</h1>
    <p class="form-subtitle">Share your thoughts with the world.</p>

    <form action="/posts" method="POST" class="post-form" id="new-post-form">
      <div class="form-group">
        <label for="title" class="form-label">Title</label>
        <input
          type="text"
          id="title"
          name="title"
          class="form-input"
          placeholder="Give your post an interesting title…"
          required
          autofocus
        />
      </div>

      <div class="form-group">
        <label for="author" class="form-label">Author</label>
        <input
          type="text"
          id="author"
          name="author"
          class="form-input"
          placeholder="Your name (optional)"
        />
      </div>

      <div class="form-group">
        <label for="content" class="form-label">Content</label>
        <textarea
          id="content"
          name="content"
          class="form-input form-textarea"
          placeholder="Write your story…"
          rows="12"
          required
        ></textarea>
      </div>

      <div class="form-actions">
        <a href="/" class="btn btn-ghost" id="cancel-btn">Cancel</a>
        <button type="submit" class="btn btn-primary" id="publish-btn">Publish Post</button>
      </div>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
