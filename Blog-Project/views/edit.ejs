<%- include('partials/header') %>

<section class="form-page" id="edit-post-page">
  <div class="form-container">
    <h1 class="form-title">Edit Post</h1>
    <p class="form-subtitle">Refine your words, perfect your message.</p>

    <form action="/posts/<%= post.id %>?_method=PUT" method="POST" class="post-form" id="edit-post-form">
      <div class="form-group">
        <label for="title" class="form-label">Title</label>
        <input
          type="text"
          id="title"
          name="title"
          class="form-input"
          value="<%= post.title %>"
          required
          autofocus
        />
      </div>

      <div class="form-group">
        <label for="author" class="form-label">Author</label>
        <input
          type="text"
          id="author"
          name="author"
          class="form-input"
          value="<%= post.author %>"
        />
      </div>

      <div class="form-group">
        <label for="content" class="form-label">Content</label>
        <textarea
          id="content"
          name="content"
          class="form-input form-textarea"
          rows="12"
          required
        ><%= post.content %></textarea>
      </div>

      <div class="form-actions">
        <a href="/posts/<%= post.id %>" class="btn btn-ghost" id="cancel-edit-btn">Cancel</a>
        <button type="submit" class="btn btn-primary" id="save-btn">Save Changes</button>
      </div>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
